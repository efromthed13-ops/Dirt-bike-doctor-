{
  "name": "Dirt Bike Doctor",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "postCreateCommand": "npm install",
  "forwardPorts": [
    8081
  ],
  "portsAttributes": {
    "8081": {
      "label": "Expo development server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
